  "name": "Social Addon",
  "description": "Social features for Meteor Client: alt tracking, scary people, blacklist, and social tab UI.",
  "authors": [
    "pizzav"
  ],
  "contact": {
    "sources": "https://github.com/pizzav-xyz/meteorshit"
  },
  "icon": "assets/meteor-social-addon/icon.png",
